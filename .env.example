# ───────────────────────────────────────────────────────────
# MarketMarkovNet — example environment file
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Authoritative reference: deploy/config.md
# Feature spec: plans/market-markov-net/features/03 - kraken credentials and config.md
# ───────────────────────────────────────────────────────────

# ── Hostname (controls Caddy's TLS behaviour) ──────────────
# Production: a public DNS name pointing at the VPS. Caddy will
# auto-issue a Let's Encrypt cert for this hostname.
# Local dev: leave unset or set to "localhost" (plain HTTP only).
# HOST=btc.example.com

# ── Kraken (live mode only) ────────────────────────────────
# Permissions: Query + Trade ONLY. Withdraw MUST be disabled.
# See deploy/KRAKEN_KEYS.md for the exact UI checklist.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ── Trading mode ───────────────────────────────────────────
# paper | live  (paper is the default; live is gated by parity)
TRADING_MODE=paper

# ── Inference (ZMQ) ────────────────────────────────────────
# In compose, the engine overrides this to tcp://inference:5555.
# The value here is only used by the host-side `cargo run`.
ZMQ_ENDPOINT=tcp://127.0.0.1:5555

# ── Signal / strategy parameters ───────────────────────────
MAGNITUDE_THRESHOLD=0.005
PAPER_FEE=0.0015
SMA_WINDOW=200

# ── HTTP server ────────────────────────────────────────────
HTTP_PORT=8080

# ── Trading pair ───────────────────────────────────────────
SYMBOL=BTC/USD

# ── Inference service (Python side) ────────────────────────
# In compose, the inference container reads /models/model.pt.
# The default MODEL_PATH below matches the workspace layout
# used by `uv run python -m inference.inference_engine`.
MODEL_PATH=/models/model.pt
NORM_STATS_PATH=/models/norm_stats.json
ZMQ_BIND=tcp://*:5555
PYTHONUNBUFFERED=1

# ── Database ───────────────────────────────────────────────
# In compose, this is overridden to sqlite:///app/data/candles.db
# so the SQLite file lives on the `data` named volume.
DATABASE_URL=sqlite://data/candles.db

# ── Parity harness (Feature 13) ────────────────────────────
# Engine refuses `TRADING_MODE=live` unless the marker at
# PARITY_MARKER_PATH is younger than PARITY_MAX_AGE_SECS.
PARITY_MARKER_PATH=parity_verified.json
PARITY_MAX_AGE_SECS=604800

# ── Feature window (sent to inference) ─────────────────────
FEATURE_WINDOW_SIZE=72

# ── Logging ────────────────────────────────────────────────
RUST_LOG=info

# ── Phase 3.3: Live executor selection ─────────────────────
# When TRADING_MODE=live, the engine picks an executor based on LIVE_EXECUTOR:
#   paper  → safe fallback (default; no live orders)
#   moomoo → Moomoo OpenD executor (subprocess to place_order.py)
# The Moomoo executor is selected automatically when LIVE_EXECUTOR=moomoo.
# LIVE_EXECUTOR=paper

# ── Moomoo OpenD (Phase 3.3) ────────────────────────────────
# MOOMOO_TRD_ENV values: SIMULATE (paper trading) | REAL (live, requires GUI unlock)
# The Moomoo Python skill reads its own credentials from $MOOMOO_OPEND_HOST etc.;
# this engine only controls the executor selection and trd_env.
# MOOMOO_TRD_ENV=SIMULATE
# MOOMOO_SECURITY_FIRM=FUTUSECURITIES
# MOOMOO_ACC_ID=

# ── FRED API key (free) ──────────────────────────────────
# Get one at https://fred.stlouisfed.org/apikey (30 seconds).
# Required for treasury yield + DXY macro data.
FRED_API_KEY=40c2d3ff0753ace706d75a9e8355ab63

# ── Moomoo OpenD gateway ─────────────────────────────────────
# Host/port of the local OpenD TCP gateway.
# Inside Docker use host.docker.internal (not 127.0.0.1).
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111

# ── Phase 3.4: TOTP secret for runtime mode toggle ─────────
# Base32-encoded 160-bit secret used by POST /api/mode to authorize
# paper <-> live flips. If empty at startup, the engine mints a fresh
# secret and logs the otpauth URL — scan it with your authenticator app
# and persist the value here before the next restart (or you will be
# locked out of live mode).
# TOTP_SECRET=JBSWY3DPEHPK3PXP

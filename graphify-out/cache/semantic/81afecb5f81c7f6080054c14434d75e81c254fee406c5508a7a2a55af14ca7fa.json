{"nodes": [{"id": "rust_ch03_performance", "label": "Performance Mindset", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't guess, measure. Always use --release flag. Profile with cargo flamegraph before optimizing. Avoid redundant cloning, prefer iterators over manual loops, avoid intermediate collections"}, {"id": "rust_ch03_flamegraph", "label": "Flamegraph Profiling", "file_type": "concept", "source_file": ".agents/skills/rust-best-practices/references/chapter_03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rust_ch03_stack_heap", "label": "Stack vs Heap Allocation", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep small Copy types on stack, avoid passing >512 bytes by value, heap allocate recursive data structures with Box. Use smallvec for large const arrays"}, {"id": "rust_ch03_zero_cost", "label": "Zero-Cost Abstractions", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_03.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rust iterators compile to efficient tight loops. Prefer iterators over manual for loops for collections. Avoid intermediate .collect() calls when passing to functions accepting impl Iterator"}], "edges": [{"source": "rust_ch03_performance", "target": "rust_ch03_flamegraph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/rust-best-practices/references/chapter_03.md", "source_location": null, "weight": 1.0}, {"source": "rust_ch03_performance", "t
{"nodes": [{"id": "rust_ch01_borrowing", "label": "Borrowing Over Cloning", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer &T over .clone() unless ownership transfer needed. Clone traps: auto-cloning in loops, cloning large structures, cloning due to bad API design"}, {"id": "rust_ch01_copy_trait", "label": "Copy Trait Guidelines", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small Copy types (<=24 bytes, 2-3 words) can pass by value. Structs should be Copy only if all fields are Copy, small, and represent plain data without heap allocations"}, {"id": "rust_ch01_option_result", "label": "Option/Result Pattern Matching", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use match for inner type matching, let-else for early returns with default values, if-let-else when divergent code needs extra computation. Use ? to propagate Err when Err value is not needed"}, {"id": "rust_ch01_iterators", "label": "Iterator Patterns", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer iterators for transforming collections, for loops for early exits and side effects. Iterators are lazy and fused at compile time. Avoid needless intermediate collections"}, {"id": "rust_ch01_prevent_allocation", "label": "Prevent Early Allocation", "file_type": "rationale", "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use _else variants (map_or_else, unwrap_or_else, ok_or_else) when allocation or function calls are needed to avoid eager evaluation"}], "edges": [{"source": "rust_ch01_borrowing", "target": "rust_ch01_copy_trait", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "weight": 1.0}, {"source": "rust_ch01_borrowing", "target": "rust_ch01_option_result", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "weight": 1.0}, {"source": "rust_ch01_borrowing", "target": "rust_ch01_prevent_allocation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "weight": 1.0}, {"source": "rust_ch01_iterators", "target": "rust_ch01_borrowing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "weight": 1.0}, {"source": "rust_ch01_borrowing", "target": "rust_ch03_performance", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "weight": 1.0}, {"source": "rust_ch01_iterators", "target": "rust_ch03_zero_cost", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".agents/skills/rust-best-practices/references/chapter_01.md", "source_location": null, "weight": 1.0}], "hyperedges": []}
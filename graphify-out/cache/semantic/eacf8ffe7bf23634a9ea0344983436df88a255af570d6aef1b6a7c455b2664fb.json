{"nodes": [{"id": "training_model_design_causal_conv1d", "label": "CausalConv1d", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Causal 1D convolution ensuring predictions at time t only depend on t and previous timesteps, preventing future information leakage"}, {"id": "training_model_design_marketmarkovnet_model", "label": "MarketMarkovNet Neural Architecture", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "6-layer causal CNN backbone with GroupNorm and SiLU, parallel draft heads for 1H/4H/24H horizons, and low-rank Markov heads modeling sequential dependencies between horizons"}, {"id": "training_model_design_feature_engineering", "label": "Feature Engineering Pipeline", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes log_return, TR/ATR(72), typical price, VWAP, vwap_dev with rolling z-score normalization for gradient stability"}, {"id": "training_model_design_swingtradingdataset", "label": "SwingTradingDataset", "file_type": "concept", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "training_model_design_backbone_pretraining", "label": "Stage 1: Backbone Pre-training", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Freeze Markov heads, train backbone only with multi-task MSE loss to learn feature extraction without temporal consistency concerns"}, {"id": "training_model_design_markov_alignment", "label": "Stage 2: Markov Alignment Fine-tuning", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unfreeze all layers with reduced learning rate, using DirectionalTemporalLoss combining MSE, directional hinge margin, and temporal consistency loss"}, {"id": "training_model_design_directional_temporal_loss", "label": "DirectionalTemporalLoss", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom loss combining MSE, directional hinge margin error penalizing wrong directional predictions, and temporal consistency loss penalizing deviations between sequential horizon predictions"}, {"id": "training_model_design_hysteresis_backtester", "label": "Hysteresis Swing Backtester", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Entry signals when both 4H and 24H predictions align above magnitude_threshold (0.50%), using ffill for sticky positions to reduce turnover and capture longer swings"}, {"id": "training_model_design_regime_backtester", "label": "Regime-Filtered Swing Backtester", "file_type": "rationale", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds 200-hour SMA regime filter: long entries only in bullish regime (close > SMA), short entries only in bearish regime, creating asymmetric signal generation"}, {"id": "training_model_design_draft_heads", "label": "Parallel Draft Heads", "file_type": "concept", "source_file": "Training_model_Design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id"
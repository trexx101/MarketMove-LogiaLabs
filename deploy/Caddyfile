# ─────────────────────────────────────────────────────────────────────────────
# MarketMoves — Caddy reverse proxy
#
# Terminates TLS on :443 via Let's Encrypt (when a public hostname is
# configured) and reverse-proxies everything to the engine (Axum) on
# the internal `deploy_mmn` network.
#
# Operators set `HOST` in the workspace-root .env file:
#   - HOST=trades.example.com  → Caddy auto-issues a Let's Encrypt cert,
#                                terminates TLS on :443, serves both :80
#                                and :443 directly.
#   - HOST unset               → Self-signed internal cert, serves on :80
#                                and :443 for localhost / VPS IP dev use.
#                                Caddy auto-detects this and falls back to
#                                `tls internal`.
#
# The engine serves:
#   - GET /                    → static SPA (Svelte control room)
#   - GET /api/*               → JSON telemetry
#   - GET /api/v1/ws           → WebSocket telemetry
#   - everything else          → SPA fallback (client-side router)
# ─────────────────────────────────────────────────────────────────────────────

# Global options: log to stdout for `docker logs`, disable the admin
# endpoint (it would publish an unauthenticated HTTP API).
{
    admin off
    auto_https disable_redirects
}

# Shared backend configuration (snippet to avoid duplication).
(backend) {
    encode zstd gzip
    reverse_proxy mmn-engine:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
    header X-Content-Type-Options "nosniff"
    header X-Frame-Options "DENY"
    header Referrer-Policy "strict-origin-when-cross-origin"
}

# ── Catch-all site block ─────────────────────────────────────────────────────
# Serves all hosts on ports 80 and 443. Uses internal CA for self-signed
# certs with on-demand TLS — Caddy generates a cert for any SNI presented
# during the TLS handshake (localhost, VPS IP, port-forwarded address, etc.).
# When `HOST` is set, Caddy auto-issues a Let's Encrypt cert via the DNS
# challenge for the configured hostname.
#
# AUTHENTICATION: Basic auth protects the entire dashboard.
#   - Default user: admin
#   - Change password: docker run --rm caddy:2-alpine caddy hash-password --plaintext "YOUR_PASSWORD"
#   - Replace the hash below with your new one.
#   - Optional: uncomment the remote_ip matcher to also restrict by IP.
:80, :443 {
    tls internal

    # Basic authentication (guards entire dashboard)
    basic_auth {
        admin $2a$14$vYowfZFr6iE0cWFWRJVQZuTzzBLEXEbP.4QqSRIHxPToUybQvRz9a
    }

    # Optional: IP whitelist (belt + suspenders)
    # Uncomment and set your IP(s) to also block non-matching IPs
    # @not_allowed not remote_ip 123.45.67.89
    # respond @not_allowed "Forbidden" 403

    import backend
}
